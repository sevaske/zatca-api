{
    "name": "sevaske/zatca-api",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sevaske\\ZatcaApi\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "sevaske"
        }
    ],
    "require": {
        "php": "^7.4||^8.0",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0||^2.0",
        "sevaske/support": "^1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "phpunit --testdox",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/sevaske/zatca-api"
    }
}
